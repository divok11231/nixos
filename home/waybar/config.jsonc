[
  {
    "layer": "top",
    "position": "top",
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "pulseaudio",
      "network",
      "battery",
      "tray"
    ],
    "clock": {
      "format": "{:%a %d %b  %H:%M}"
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      }
    },
    "custom/osk": {
      "exec": "echo ⌨",
      "exec-if": "pgrep -x wvkbd-mobintl",
      "interval": 5,
      "on-click": "pkill -RTMIN wvkbd-mobintl",
      "tooltip": false
    },
    "network": {
      "format-wifi": "  {signalStrength}%",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰖪"
    },
    "tray": {
      "spacing": 8
    }
  }
]
